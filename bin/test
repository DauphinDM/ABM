#!/bin/sh
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
"$ROOT/bin/build"
mkdir -p "$ROOT/build/tests"
exec 8>"$ROOT/build/.test.lock"
flock 8
cd "$ROOT/build/tests"
qmake6 "$ROOT/tests/abm_tests.pro"
make -j"$(nproc)"
QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software QT_FORCE_STDERR_LOGGING=1 ./abm_tests -nocrashhandler "$@"
cd "$ROOT"
luajit tests/game_test.lua
node tests/plugin_test.cjs
python tests/cli_test.py
python tests/standalone_test.py
